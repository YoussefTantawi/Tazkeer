<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#0b1014</color>
    <color name="bottom_nav">#202327</color>
    <color name="disabled_color">#E5E7EB</color>
    <color name="gold">#F4B942</color>
    <color name="green">#34D399</color>
    <color name="surface">#202327</color>
    <color name="text_on_gray">#202327</color>
    <color name="text_on_teal">#202327</color>
    <color name="text_primary">#E5E7EB</color>
    <color name="text_secondary">#CBD5E1</color>
    <style name="Theme.Tazkeer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bottom_nav</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/bottom_nav</item>
    </style>
    <style name="Theme.Tazkeer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_tazkeer_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/surface</item>
        <item name="postSplashScreenTheme">@style/Theme.Tazkeer</item>
    </style>
</resources>