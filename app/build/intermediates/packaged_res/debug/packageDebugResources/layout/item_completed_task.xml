<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/completedTaskCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <TextView
                android:id="@+id/completedTaskTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/completedTaskCheckBox"
                app:layout_constraintTop_toTopOf="@id/completedTaskCheckBox" />

            <CheckBox
                android:id="@+id/completedTaskCheckBox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:button="@drawable/selector_checkbox_rounded"
                android:buttonTint="@color/green"
                android:checked="true"
                android:contentDescription="@string/content_uncomplete_task"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/completedTaskDescriptionText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@id/completedTaskTitleText"
                app:layout_constraintStart_toStartOf="@id/completedTaskTitleText"
                app:layout_constraintTop_toBottomOf="@id/completedTaskTitleText" />

            <TextView
                android:id="@+id/completedTaskTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/completedTaskTitleText"
                app:layout_constraintTop_toBottomOf="@id/completedTaskDescriptionText" />

            <TextView
                android:id="@+id/completedTaskCategoryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                app:layout_constraintBaseline_toBaselineOf="@id/completedTaskTimeText"
                app:layout_constraintStart_toEndOf="@id/completedTaskCategoryIcon" />

            <ImageView
                android:id="@+id/completedTaskCategoryIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/category"
                app:layout_constraintBottom_toBottomOf="@id/completedTaskCategoryText"
                app:layout_constraintStart_toEndOf="@id/completedTaskTimeText"
                app:layout_constraintTop_toTopOf="@id/completedTaskCategoryText"
                app:tint="@color/green" />

            <TextView
                android:id="@+id/completedTaskPriorityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintBaseline_toBaselineOf="@id/completedTaskCategoryText"
                app:layout_constraintStart_toEndOf="@id/completedTaskCategoryText" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
