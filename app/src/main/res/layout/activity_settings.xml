<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/settings_title"
        app:titleTextColor="?android:attr/textColorPrimary" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/settingsBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/darkModeSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/dark_mode"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/languageSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/use_arabic_language"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/darkModeSwitch" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/timeFormatSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/time_format_24h"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/languageSwitch" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notificationsSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/notifications"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timeFormatSwitch" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/summarySectionSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/activate_summary_section"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/notificationsSwitch" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/upcomingSectionSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/activate_upcoming_task_section"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/summarySectionSwitch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateLocationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/update_location"
                android:textAllCaps="false"
                android:textColor="@color/text_on_teal"
                app:backgroundTint="@color/green"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/upcomingSectionSwitch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/contactUsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:text="@string/contact_us"
                android:textAllCaps="false"
                android:textColor="@color/text_on_gray"
                app:backgroundTint="@color/disabled_color"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toStartOf="@id/shareAppButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/updateLocationButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareAppButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="18dp"
                android:text="@string/share_app"
                android:textAllCaps="false"
                android:textColor="@color/text_on_gray"
                app:backgroundTint="@color/disabled_color"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/contactUsButton"
                app:layout_constraintTop_toBottomOf="@id/updateLocationButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetPreferencesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/reset_preferences"
                android:textAllCaps="false"
                android:textColor="@color/text_on_gray"
                app:backgroundTint="@color/disabled_color"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/shareAppButton" />

            <TextView
                android:id="@+id/appInfoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/app_info"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/resetPreferencesButton" />

            <TextView
                android:id="@+id/appInfoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingBottom="96dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appInfoTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/settingsBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:itemIconTint="@color/green"
        app:itemTextColor="@color/green"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_navigation" />
</androidx.constraintlayout.widget.ConstraintLayout>
