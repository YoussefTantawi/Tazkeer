<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detailsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <TextView
                android:id="@+id/detailsHeaderText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/task_details"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/detailsTitleLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/task_title"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsHeaderText" />

            <TextView
                android:id="@+id/detailsTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsTitleLabel" />

            <TextView
                android:id="@+id/detailsDescriptionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/task_description"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsTitleText" />

            <TextView
                android:id="@+id/detailsDescriptionText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsDescriptionLabel" />

            <TextView
                android:id="@+id/detailsTimeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/task_time"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/detailsCategoryLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsDescriptionText" />

            <TextView
                android:id="@+id/detailsCategoryLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/category"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/detailsTimeLabel"
                app:layout_constraintTop_toTopOf="@id/detailsTimeLabel" />

            <TextView
                android:id="@+id/detailsTimeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/detailsTimeLabel"
                app:layout_constraintStart_toStartOf="@id/detailsTimeLabel"
                app:layout_constraintTop_toBottomOf="@id/detailsTimeLabel" />

            <TextView
                android:id="@+id/detailsCategoryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/detailsCategoryLabel"
                app:layout_constraintStart_toStartOf="@id/detailsCategoryLabel"
                app:layout_constraintTop_toBottomOf="@id/detailsCategoryLabel" />

            <TextView
                android:id="@+id/detailsPriorityLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/priority"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toStartOf="@id/detailsRecurrenceLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsTimeText" />

            <TextView
                android:id="@+id/detailsRecurrenceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/recurrence"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/detailsPriorityLabel"
                app:layout_constraintTop_toTopOf="@id/detailsPriorityLabel" />

            <TextView
                android:id="@+id/detailsPriorityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="@id/detailsPriorityLabel"
                app:layout_constraintTop_toBottomOf="@id/detailsPriorityLabel" />

            <TextView
                android:id="@+id/detailsRecurrenceText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/detailsRecurrenceLabel"
                app:layout_constraintStart_toStartOf="@id/detailsRecurrenceLabel"
                app:layout_constraintTop_toBottomOf="@id/detailsRecurrenceLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeDetailsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/close"
                android:textAllCaps="false"
                android:textColor="@color/text_on_teal"
                app:backgroundTint="@color/green"
                app:cornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsRecurrenceText" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
